<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Build target selector (same pattern as Zigerus/jellyfin-plugin-dtdd and JS Injector 4.0):
           JellyfinTarget=jf12 -> Jellyfin 12.x,   net10.0 (default)
           JellyfinTarget=jf10 -> Jellyfin 10.11.x, net9.0
         One source, two artifacts. Select with `dotnet publish -p:JellyfinTarget=jf10`.
         Each target restores its own assets; do not pass -\-no-restore when switching. -->
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">jf12</JellyfinTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>Jellyfin.Plugin.JMSFusion</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.JMSFusion</RootNamespace>

    <Version>3.7.0.2</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Package versions sit on each target's ABI FLOOR (12.0.0 / 10.11.0), never the host's
       patch version: a newer host satisfies a lower reference, the reverse does not load. -->
  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf12'">
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinVersion>12.0.0</JellyfinVersion>
    <JellyfinTargetAbi>12.0.0.0</JellyfinTargetAbi>
    <MsExtVersion>10.0.0</MsExtVersion>
    <DefineConstants>$(DefineConstants);JELLYFIN_12</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf10'">
    <TargetFramework>net9.0</TargetFramework>
    <JellyfinVersion>10.11.0</JellyfinVersion>
    <JellyfinTargetAbi>10.11.0.0</JellyfinTargetAbi>
    <MsExtVersion>9.0.10</MsExtVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JMSFusion</PackageId>
    <Authors>G-Grbz</Authors>
    <Company>JMS</Company>
    <Description>
      Inject custom JS into Jellyfin web UI via in-memory transform (no file writes), with FileProvider wrapping;
      fallback to middleware and optional index.html patch. Serves /slider from external dir or embedded Resources/slider.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Common"    Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Data"      Version="$(JellyfinVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MsExtVersion)" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/**/*" />
    <EmbeddedResource Include="Resources/**/*" />
    <EmbeddedResource Include="RuntimeModules/**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="meta.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="UpdateMetaJson"
          BeforeTargets="CopyFilesToOutputDirectory;ComputeFilesToPublish">
    <Message Text="Updating meta.json (timestamp &amp; version &amp; imagePath)..." Importance="high" />
    <Exec Command="bash ./update_meta.sh &quot;$(Version)&quot; &quot;$(JellyfinTargetAbi)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
